{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "module": "ES2020",
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2020", "DOM"],
    "paths": {}
  },
  "exclude": ["node_modules", "tmp"]
}
